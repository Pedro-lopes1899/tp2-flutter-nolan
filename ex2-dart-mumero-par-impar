// Programa em Dart que verifica se um número é par ou ímpar

void main() {
  int numero = 17; // número qualquer definido

  verificarParidade(numero);
}

void verificarParidade(int numero) {
  if (numero % 2 == 0) {
    print('O número $numero é PAR.');
  } else {
    print('O número $numero é ÍMPAR.');
  }
}
